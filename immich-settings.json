{
  "_comment": "Overrides applied on top of Immich defaults by apply-settings.py. Hardware: Ryzen 7 5800X (8C/16T), 32 GB RAM, RTX 3060 Ti 8 GB.",
  "storageTemplate": {
    "enabled": true,
    "template": "{{y}}/{{y}}-{{MM}}-{{dd}}/{{filename}}"
  },
  "job": {
    "thumbnailGeneration": {"concurrency": 8},
    "metadataExtraction": {"concurrency": 8},
    "videoConversion": {"concurrency": 3},
    "faceDetection": {"concurrency": 4},
    "smartSearch": {"concurrency": 4},
    "ocr": {"concurrency": 2}
  },
  "machineLearning": {
    "clip": {"modelName": "nllb-clip-large-siglip__v1"}
  },
  "ffmpeg": {
    "accel": "nvenc",
    "accelDecode": true,
    "preset": "medium"
  }
}
