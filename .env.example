# Immich v3 — see immich-rebuild-handoff.md. Docs: https://docs.immich.app/install/environment-variables

# Photos library on the WD 4TB disk (ext4 after migration). Container path: /data
UPLOAD_LOCATION=/mnt/data/immich

# Postgres must stay on the local SSD (ext4). Absolute path so it never lands in a Docker volume.
DB_DATA_LOCATION=/home/jackwan/workspace/immich-server-config/postgres

TZ=America/Los_Angeles

# Pinned; upgrade deliberately (check release notes first)
IMMICH_VERSION=v3.2.4

# Only A-Za-z0-9
DB_PASSWORD=<generate with: openssl rand -hex 16>

DB_USERNAME=postgres
DB_DATABASE_NAME=immich
